# Copier ce fichier en .env puis changer les valeurs
# (éviter les caractères @ : / dans les mots de passe, ils cassent l'URL de connexion)

# --- Oracle (Docker Compose) ---
ORACLE_PASSWORD=changeme_admin
# Propriétaire du schéma (migrations Alembic uniquement)
APP_USER=biblio
APP_USER_PASSWORD=changeme_owner
# Utilisateur de l'API (lecture/écriture des données seulement)
API_USER=biblio_api
API_USER_PASSWORD=changeme_api

# --- Connexion de l'API ---
# 127.0.0.1 et pas localhost : sous Windows, localhost passe par IPv6 et bloque avec Docker Desktop
DB_HOST=127.0.0.1
DB_PORT=1521
DB_SERVICE=FREEPDB1

# --- Sécurité (JWT) ---
# Générer une clé : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
